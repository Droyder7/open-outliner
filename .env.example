# Copy to .env for Compose. Generate a URL-safe password (openssl rand -hex 24).
POSTGRES_PASSWORD=outliner
WEB_PORT=8080
# Remote browser access needs HTTPS for service workers, IndexedDB and UUID APIs.
WEB_BIND=127.0.0.1
# Attachments are optional. Empty endpoint leaves all text workflows available.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=open-outliner
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
