{
  "name": "@open-outliner/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "node --env-file=.env dist/main.js",
    "migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@open-outliner/shared": "workspace:*",
    "@open-outliner/crdt": "workspace:*",
    "@hocuspocus/server": "^2.15.2",
    "@hocuspocus/extension-database": "^2.15.2",
    "@hocuspocus/common": "^2.15.2",
    "pg": "^8.13.1",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
