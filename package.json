{
  "name": "open-outliner",
  "version": "0.0.0",
  "private": true,
  "description": "Offline-first collaborative outliner (Workflowy-parity) on Yjs + PostgreSQL.",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r build",
    "migrate": "pnpm --filter @open-outliner/server migrate"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/lib-storage": "^3.1092.0",
    "@aws-sdk/s3-request-presigner": "^3.1092.0"
  }
}
